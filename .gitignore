# Publish only maintained source, documentation and required simulation assets.
/*
!/.gitignore
!/README.md
!/DIRECT_ELASTIC_README.md
!/controllers/
!/protos/
!/worlds/
!/scripts/
!/backend/

# Local credentials and configuration (never override these for publication).
**/.env
**/.env.*
**/secrets/
**/credentials/
**/*credentials*.json
**/*credentials*.yml
**/*credentials*.yaml
**/*secret*.json
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.pfx
**/*.p12
**/*.jks
**/id_rsa*
**/id_ed25519*
**/config.local.*
**/settings.local.*

# Runtime data, spool, databases, logs, caches and local tools.
**/data/
**/spool/
**/*_spool/
**/backups/
**/_backup/
**/logs/
**/*.log
**/*.sqlite*
**/*.db
**/*.db-*
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage*
**/htmlcov/
**/node_modules/
**/.claude/
**/.codex/
**/.vscode/
**/.idea/

# Generated reports, editor state, binaries and temporary experiments.
**/*.runtime.json
**/*.validation.json
**/*.clearance.json
**/*.wbproj
**/.secureguard*.jpg
**/*.exe
**/*.dll
**/*.o
**/*.obj
**/*.zip
**/*.7z
**/*.pdf
**/*.docx
**/*.xlsx
**/*.tmp
**/*.bak
**/*~
**/tmp/
**/temp/
**/test-results/
**/dist/
**/build/
**/Thumbs.db
**/desktop.ini
**/.DS_Store
